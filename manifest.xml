<?xml version="1.0"?>
<!-- Regenerated for issue #30. If a build has already been sideloaded
     anywhere, changing this again makes it a different app. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application id="d99bb18d11ed41bcb2f365b8cdfe0f6b"
                    type="watch-app"
                    name="@Strings.AppName"
                    entry="FreelapApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.1.0">
        <iq:products>
            <!-- Broad CIQ 3.1+ BLE-capable set. Trim to what you own/test. -->
            <iq:product id="fenix5plus"/>
            <iq:product id="fenix6"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fr245"/>
            <iq:product id="fr245m"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr645m"/>
            <iq:product id="fr745"/>
            <iq:product id="fr945"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="fr165"/>
            <iq:product id="venu"/>
            <iq:product id="venu2"/>
            <iq:product id="venu3"/>
            <iq:product id="vivoactive4"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="epix2"/>
            <iq:product id="enduro"/>
            <iq:product id="marqathlete"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <!-- Fit gates ActivityRecording.createSession(); FitContributor gates
                 Session.createField(). Both are needed: one records the activity,
                 the other adds our developer fields to it. -->
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="FitContributor"/>
            <!-- Positioning, Sensor and SensorHistory were declared here and
                 never used: no source file references Toybox.Position or
                 Toybox.Sensor. Removing them changes no behaviour - declaring
                 Positioning does not record GPS, that needs
                 Position.enableLocationEvents - but it stops the store listing
                 asking for location from someone who then has to decide
                 whether to trust the request. See docs/store/LISTING.md if you
                 want a GPS track; it needs the permission *and* the code. -->
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
